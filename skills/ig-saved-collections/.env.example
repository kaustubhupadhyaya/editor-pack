# Copy this file to `.env` in this same folder and fill in the real values.
# `.env` is gitignored at the repo root — it will never be committed.
# NEVER paste real values into THIS file (.env.example) — this template IS
# committed to git.
#
# Multiple Instagram accounts: for a second/third account, copy this to
# `.env.<account_username>` instead of plain `.env` (also gitignored — see
# the .gitignore pattern `.env.*`), then pass `--account <account_username>`
# to list_collections.py / extract_saved.py / refresh_session.py. Each
# account also gets its own browser profile automatically
# (`.pw-profile.<account_username>/`) so logins don't collide.
#
# These credentials are read ONLY by the local Python scripts in this skill,
# on THIS machine. They are never sent anywhere else (not to Claude, not to
# Anthropic, not to any third party) — Instagram is the only server they
# talk to.

# Your Instagram browser session cookie. Auto-refreshed by
# scripts/refresh_session.py if IG_USERNAME/IG_PASSWORD are set below;
# to set it manually instead: DevTools (F12) -> Application tab -> Cookies ->
# https://www.instagram.com -> row "sessionid" -> copy its Value column.
# It's a session token, not your password — invalidate it anytime by logging
# out of Instagram in that browser.
IG_SESSIONID=

# Optional: Instagram login credentials, used ONLY by
# scripts/refresh_session.py to log in via a real (Playwright) browser and
# refresh IG_SESSIONID automatically when it expires. Leave blank if you
# prefer pasting the sessionid by hand.
IG_USERNAME=
IG_PASSWORD=

# Optional: path to a cookies.txt file (Netscape format) exported via a
# "Get cookies.txt LOCALLY"-style browser extension. Only needed if you'd
# rather pass gallery-dl a cookie file than use --cookies-from-browser.
IG_COOKIES_FILE=
